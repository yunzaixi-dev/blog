# Application build identity; content edits do not require changing these.
SITE_URL=https://zaixi.dev
UMAMI_ID=
CODE_THEME=catppuccin
# Development / preview mounted content directory.
CONTENT_DIR=content
MEDIA_DIR=public
DEV_PORT=45100
API_PORT=45101
# Optional remote Git metadata enrichment; disabled by default for offline startup.
GIT_HISTORY_REMOTE=0
# Production Pages shell calls this origin; leave empty for local same-origin API proxy.
API_BASE_URL=
# Exact browser origins accepted by Go, comma-separated; no credentials or wildcard.
CORS_ORIGINS=
# Public read-only R2 custom domain; upload credentials belong only to the importer.
MEDIA_BASE_URL=https://blog-media.zaixi.dev
DATABASE_URL=
TYPESENSE_URL=
TYPESENSE_API_KEY=
R2_BUCKET=zaixi-blog-media
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "postcss.config.js",
    "prettier.config.js",
    "eslint.config.mjs",
    "playwright.config.ts",
    "vitest.config.ts",
    "app/**/*.{ts,tsx}",
    "scripts/**/*.mjs",
    "tests/**/*.{ts,tsx}",
    "app/main.tsx",
    "vite.config.ts",
    "vite.worker.config.ts",
    "server/content-worker.ts",
    "scripts/*.mjs"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "content-pipeline/**/*.{ts,tsx}",
    "data/**/*.{ts,tsx}",
    "layouts/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "playwright.config.ts",
    "postcss.config.js",
    "prettier.config.js",
    "scripts/**/*.{js,mjs}",
    "tests/**/*.{ts,tsx}",
    "vitest.config.ts",
    "server/**/*.ts",
    "vite*.ts"
  ],
  "ignoreBinaries": ["scripts/quality-html.sh", "go", "gofmt", "test"],
  "ignoreDependencies": [
    "@tailwindcss/typography",
    "eslint-config-prettier",
    "eslint-plugin-jsx-a11y",
    "sharp",
    "tailwindcss"
  ]
}
